# -----------------------------------------------------------------------------
# AI Compliance Evidence Collector - environment template
# Copy to `.env` and adjust values. Never commit `.env`.
# -----------------------------------------------------------------------------

# --- PostgreSQL ---
POSTGRES_DB=compliance
POSTGRES_USER=compliance
POSTGRES_PASSWORD=change-me

# --- JWT ---
# Use a long random string in real environments (>= 32 bytes).
JWT_SECRET=change-me-please-use-a-long-random-secret-of-at-least-32-bytes

# --- Backend (Spring Boot) ---
# When running under docker-compose this is set by the `backend` service.
# Uncomment to override in local (non-docker) runs.
# SPRING_PROFILES_ACTIVE=default

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Qdrant (vector store) ---
QDRANT_URL=http://qdrant:6333

# --- Object storage (MinIO locally, S3 in production) ---
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=change-me-minio-secret
S3_BUCKET=evidence

# --- AI service ---
AI_SERVICE_URL=http://ai-service:8000

# --- LLM / embeddings (provider-independent; leave blank until wired) ---
# Example values (do NOT commit real keys):
#   LLM_PROVIDER=openai
#   LLM_API_KEY=sk-...
#   LLM_MODEL=gpt-4o-mini
#   EMBEDDING_MODEL=text-embedding-3-small
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_MODEL=
