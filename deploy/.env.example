# Copy this file to `.env` next to `docker-compose.hub.yml` before running.

# --- Postgres ---
POSTGRES_DB=compliance
POSTGRES_USER=compliance
POSTGRES_PASSWORD=change-me

# --- Backend / JWT ---
# Use a long random string (32+ bytes) in real deployments.
JWT_SECRET=change-me-please-use-a-long-random-secret-of-at-least-32-bytes

# --- Secret store master key (base64 of 32 bytes) ---
# REQUIRED. This deployment fails to start without it (SECRET_STORE_REQUIRE_MASTER_KEY=true) --
# a real deployment must not silently fall back to a regenerated-on-restart key, since that
# orphans every stored integration credential. Generate one with:
#   openssl rand -base64 32
# or, on Windows PowerShell:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
# Rotating it later re-encrypts nothing automatically -- existing stored secrets become
# unreadable, so treat rotation as "reconnect your integrations", not a routine operation.
SECRET_STORE_MASTER_KEY=

# --- MinIO / object storage ---
S3_ACCESS_KEY=minio
S3_SECRET_KEY=change-me-minio-secret
S3_BUCKET=evidence

# --- Mail (defaults to Mailpit -- nothing leaves the machine unless you set these) ---
# Fastest real-inbox option: Gmail SMTP with an app password (myaccount.google.com/apppasswords,
# requires 2-Step Verification). MAIL_FROM must be an address the relay is authorized to send as
# (your own Gmail address for Gmail SMTP, not an arbitrary domain).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
MAIL_FROM=

# --- Public URL for this deployment ---
# REQUIRED to be a real, publicly reachable URL (not localhost) whenever real emails are being
# delivered to a real inbox -- most mail providers strip/neutralize links pointing at localhost
# or private addresses. If demoing behind a tunnel (ngrok/Cloudflare Tunnel/etc.), set this to
# that tunnel's public HTTPS URL.
FRONTEND_URL=http://localhost:4200

# --- AI service (stub by default; no external key needed) ---
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_MODEL=stub-1
EMBEDDING_MODEL=stub-embed-1

# --- CORS ---
# Comma-separated origin patterns. Wildcards allowed.
CORS_ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*
